diff --git a/src/main/resources/application-postgres.properties b/src/main/resources/application-postgres.properties
new file mode 100644
index 0000000..3c91451
--- /dev/null
+++ b/src/main/resources/application-postgres.properties
@@ -0,0 +1,21 @@
+# ===========================================================
+# profile "postgres" — รันบน PostgreSQL จริง (ใช้ Docker หรือฐานภายนอก)
+# วิธีใช้:   mvn spring-boot:run -Dspring-boot.run.profiles=postgres
+#          หรือ  java -jar tiaoma-backend-1.0.0.jar --spring.profiles.active=postgres
+# เริ่มฐานได้ทันทีด้วย:  docker compose up -d db
+# (ค่าปรับได้ผ่าน environment variables: DB_URL, DB_USERNAME, DB_PASSWORD)
+# ===========================================================
+
+spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/tiaoma}
+spring.datasource.driver-class-name=org.postgresql.Driver
+spring.datasource.username=${DB_USERNAME:tiaoma}
+spring.datasource.password=${DB_PASSWORD:tiaoma}
+
+# schema ถูกสร้างและอัปเดตโดย Flyway (ไฟล์ใน db/migration) — ห้ามให้ Hibernate แก้ตารางเอง
+spring.jpa.hibernate.ddl-auto=validate
+
+# เปิด Flyway (profile postgres ใช้ Flyway แทน ddl-auto)
+spring.flyway.enabled=true
+
+# ปิด H2 console (profile นี้ไม่ใช้ H2 แล้ว)
+spring.h2.console.enabled=false
